# First provide your own DeepSeek key as DEEPSEEK_API_KEY in this shell.
: "${DEEPSEEK_API_KEY:?Set DEEPSEEK_API_KEY to your DeepSeek API key}"
unset ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_PROFILE
unset ANTHROPIC_FEDERATION_RULE_ID ANTHROPIC_ORGANIZATION_ID
unset CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY
export ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
export ANTHROPIC_AUTH_TOKEN="${DEEPSEEK_API_KEY}"
export ANTHROPIC_MODEL="${DEEPSEEK_MODEL:-deepseek-flash}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${ANTHROPIC_MODEL}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${ANTHROPIC_MODEL}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${ANTHROPIC_MODEL}"
export CLAUDE_CODE_SUBAGENT_MODEL="${ANTHROPIC_MODEL}"
# Verify the DeepSeek endpoint/model in the client; do not fall back to Anthropic.
